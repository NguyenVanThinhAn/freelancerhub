# FreelancerHub Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# DO NOT COMMIT `.env` to git.

# ─── Security ────────────────────────────────────────────────────────────────
# JWT signing secret. Use at least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_me_with_a_random_64_char_string_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Database ────────────────────────────────────────────────────────────────
# Example for PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── AI Providers ────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional fallback when GROQ_API_KEY is missing.
# Get at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of trusted frontend origins.
CORS_ORIGINS=https://freelancerhub.io.vn,https://www.freelancerhub.io.vn
