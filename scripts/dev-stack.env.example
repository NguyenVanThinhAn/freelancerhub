# scripts/dev-stack.env — bien dung boi scripts/dev.sh / dev.bat
# Copy thanh dev-stack.env va sua neu can (file nay khong bi commit).

# ---- MySQL (cai dat 1 lan) ----
# Script migrate: MYSQL_PASSWORD=123456 python scripts/migrate_to_mysql.py
# Hoac: MYSQL_PASSWORD=123456 .venv/bin/python scripts/migrate_to_mysql.py
DB_TYPE=mysql
DB_URL_MYSQL=mysql+pymysql://root:123456@localhost:3306/freelancerhub

# ---- Ports ----
PORT_API=8000
PORT_WEB=8080

# ---- Backend ----
API_DEBUG=0
